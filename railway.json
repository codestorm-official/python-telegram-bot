def show_users_list(message):
    data = load_data()
    users = data.get("users", {})
    banned = data.get("banned", [])
    text = f"👥 لیست کاربران:\n\n📊 کل: {len(users)}\n🚫 بن‌شده: {len(banned)}\n✅ فعال: {len(users) - len(banned)}\n\n"
    for i, uid in enumerate(list(users.keys())[:20], 1):
        status = "🚫" if uid in banned else "✅"
        uname = users[uid].get("username")
        text += f"{i}. {status} {uid}" + (f" (@{uname})" if uname else "") + "\n"
    if len(users) > 20:
        text += f"\n... و {len(users) - 20} کاربر دیگر"
    bot.reply_to(message, text)

def show_stats(message):
    data = load_data()
    users = data.get("users", {})
    orders = data.get("orders", [])
    pending = data.get("pending", {})
    total_sales = sum(o.get("amount", 0) for o in orders)
    vpn_orders = sum(1 for o in orders if o.get("type") == "vpn")
    stars_orders = sum(1 for o in orders if o.get("type") == "stars")
    bot.reply_to(message, f"""
📊 آمار فروش:
👥 کل کاربران: {len(users)}
📦 کل سفارشات تایید‌شده: {len(orders)}
   🔹 VPN: {vpn_orders} | ⭐ استارز: {stars_orders}
💰 کل فروش: {total_sales:,} تومان
⏳ سفارشات در انتظار: {len(pending)}
📅 {datetime.now().strftime("%Y-%m-%d %H:%M")}
""")

def broadcast_message(message):
    if str(message.from_user.id) != str(ADMIN_ID):
        return
    if message.text and message.text.strip() == "/cancel":
        bot.reply_to(message, "❌ لغو شد.")
        return
    msg = (message.text or "").strip()
    if not msg:
        bot.reply_to(message, "❌ پیام خالی.")
        return

    data = load_data()
    banned = set(data.get("banned", []))
    targets = [uid for uid in data["users"].keys() if uid not in banned]

    status_msg = bot.reply_to(message, f"📨 در حال ارسال به {len(targets)} کاربر...")
    sent, failed = 0, 0
    for uid in targets:
        try:
            bot.send_message(int(uid), f"📨 پیام از ادمین:\n\n{msg}")
            sent += 1
        except telebot.apihelper.ApiTelegramException:
            failed += 1
        time.sleep(BROADCAST_DELAY)

    safe_edit(status_msg.chat.id, status_msg.message_id, f"✅ ارسال تمام شد.\n📬 موفق: {sent}\n❌ ناموفق: {failed}")

def ask_ban_target(message):
    if str(message.from_user.id) != str(ADMIN_ID):
        return
    target = (message.text or "").strip()
    if not target.isdigit():
        bot.reply_to(message, "❌ آیدی باید عددی باشه.")
        return
    is_banned_now = target in get_banned()
    status = "🚫 در حال حاضر بن است" if is_banned_now else "✅ در حال حاضر بن نیست"
    bot.reply_to(message, f"کاربر {target}\n{status}\n\nچه کاری انجام بشه؟", reply_markup=ban_unban_keyboard(target))

