@bot.message_handler(content_types=['photo'])
def handle_photo(message):
    user_id = str(message.from_user.id)
    if user_id in get_banned():
        bot.reply_to(message, "🚫 شما بن هستید.")
        return
    if not is_member(int(user_id)):
        bot.reply_to(message, f"⚠️ اول عضو کانال {CHANNEL_ID} شو.")
        return
    
    pending = get_pending(user_id)
    if not pending:
        bot.reply_to(message, "❌ سفارش فعالی نداری.")
        return
    
    product_name = pending["product"]
    amount = pending["amount"]
    
    try:
        file_id = message.photo[-1].file_id
        file_info = bot.get_file(file_id)
        downloaded_file = bot.download_file(file_info.file_path)
        filename = f"receipt_{user_id}_{int(time.time())}.jpg"
        with open(filename, 'wb') as f:
            f.write(downloaded_file)
        with open(filename, 'rb') as f:
            bot.send_photo(ADMIN_ID, f, caption=f"""
🔔 رسید جدید!
👤 {message.from_user.first_name}
🆔 {user_id}
📦 {product_name}
💰 {amount:,} تومان
""", reply_markup=confirm_keyboard(user_id))
        os.remove(filename)
        bot.reply_to(message, "✅ رسید شما دریافت شد!")
    except Exception as e:
        bot.reply_to(message, f"❌ خطا: {e}")

