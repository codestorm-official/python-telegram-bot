def safe_edit(chat_id, message_id, text, reply_markup=None, parse_mode="HTML"):
    """ویرایش امن پیام: اگه متن/دکمه‌ها تغییری نکرده باشن تلگرام خطای
    'message is not modified' می‌ده که قبلاً کل هندلر رو کرش می‌کرد؛ الان بی‌سروصدا نادیده گرفته می‌شه."""
    try:
        bot.edit_message_text(text, chat_id, message_id, reply_markup=reply_markup, parse_mode=parse_mode)
    except telebot.apihelper.ApiTelegramException as e:
        if "message is not modified" not in str(e):
            log.warning(f"edit_message_text failed: {e}")

def safe_send(chat_id, text, reply_markup=None, parse_mode="HTML"):
    try:
        return bot.send_message(chat_id, text, reply_markup=reply_markup, parse_mode=parse_mode)
    except telebot.apihelper.ApiTelegramException as e:
        log.warning(f"send_message failed: {e}")
        return None

# قفل برای جلوگیری از خراب شدن فایل JSON در نوشتن هم‌زمان
data_lock = threading.RLock()

# ============================================================
# لایه دیتابیس (JSON + قفل + نوشتن اتمیک)
# ============================================================
def _default_data():
    return {"users": {}, "pending": {}, "banned": [], "orders": []}

def load_data():
    with data_lock:
        if os.path.exists(DATA_FILE):
            try:
                with open(DATA_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
            except (json.JSONDecodeError, OSError) as e:
                log.error(f"خطا در خواندن دیتابیس، از نسخه پشتیبان یا خالی استفاده می‌شود: {e}")
                data = _default_data()
        else:
            data = _default_data()

        data.setdefault("users", {})
        data.setdefault("pending", {})
        data.setdefault("banned", [])
        data.setdefault("orders", [])

        for uid in data["users"]:
            data["users"][uid].setdefault("purchases", [])
            data["users"][uid].setdefault("servers", [])
            data["users"][uid].setdefault("balance", 0)
            data["users"][uid].setdefault("register_date", datetime.now().strftime("%Y-%m-%d %H:%M"))
            data["users"][uid].setdefault("is_banned", uid in data["banned"])
        return data

def save_data(data):
    with data_lock:
        tmp_path = DATA_FILE + ".tmp"
        try:
            with open(tmp_path, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
            os.replace(tmp_path, DATA_FILE)  # نوشتن اتمیک، از خراب شدن فایل جلوگیری می‌کنه
        except OSError as e:
            log.error(f"خطا در ذخیره دیتابیس: {e}")

def update_data(mutator):
    """یک تابع می‌گیره، دیتا رو زیر قفل لود/تغییر/ذخیره می‌کنه (atomic read-modify-write)."""
    with data_lock:
        data = load_data()
        result = mutator(data)
        save_data(data)
        return result

def init_user(user_id, username=None):
    user_id = str(user_id)
    def _mutate(data):
        if user_id not in data["users"]:
            data["users"][user_id] = {
                "username": username,
                "purchases": [],
                "servers": [],
                "balance": 0,
                "register_date": datetime.now().strftime("%Y-%m-%d %H:%M"),
                "is_banned": False
            }
        elif username:
            data["users"][user_id]["username"] = username
        return data["users"][user_id]
    return update_data(_mutate)

def get_pending(user_id):
    return load_data()["pending"].get(str(user_id))

def set_pending(user_id, order):
    update_data(lambda d: d["pending"].__setitem__(str(user_id), order))

def update_pending_field(user_id, key, value):
    def _mutate(data):
        data["pending"].setdefault(str(user_id), {})
        data["pending"][str(user_id)][key] = value
    update_data(_mutate)

def remove_pending(user_id):
    def _mutate(data):
        data["pending"].pop(str(user_id), None)
    update_data(_mutate)

def add_purchase(user_id, product_name, server_info=None):
    user_id = str(user_id)
    def _mutate(data):
        if user_id not in data["users"]:
            data["users"][user_id] = {
                "username": None, "purchases": [], "servers": [], "balance": 0,
                "register_date": datetime.now().strftime("%Y-%m-%d %H:%M"), "is_banned": False
            }
        data["users"][user_id]["purchases"].append({
            "product": product_name,
            "date": datetime.now().strftime("%Y-%m-%d %H:%M"),
            "server": server_info
        })
        if server_info:
            data["users"][user_id]["servers"].append(server_info)
    update_data(_mutate)

def record_order(user_id, order):
    """سفارش تایید‌شده رو برای آمار فروش ثبت می‌کنه (این بخش قبلاً اصلاً انجام نمی‌شد!)."""
    def _mutate(data):
        data["orders"].append({
            "user_id": str(user_id),
            "product": order.get("product", "نامشخص"),
            "amount": order.get("amount", 0),
            "type": order.get("type", "unknown"),
            "date": datetime.now().strftime("%Y-%m-%d %H:%M")
        })
    update_data(_mutate)

def get_banned():
    return load_data().get("banned", [])

def ban_user(user_id):
    user_id = str(user_id)
    def _mutate(data):
        if user_id not in data["banned"]:
            data["banned"].append(user_id)
        if user_id in data["users"]:
            data["users"][user_id]["is_banned"] = True
    update_data(_mutate)

def unban_user(user_id):
    user_id = str(user_id)
    def _mutate(data):
        if user_id in data["banned"]:
            data["banned"].remove(user_id)
        if user_id in data["users"]:
            data["users"][user_id]["is_banned"] = False
    update_data(_mutate)

