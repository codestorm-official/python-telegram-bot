def ask_ai(user_id, question):
    try:
        history = user_conversations.setdefault(user_id, [])
        history.append({"role": "user", "content": question})
        if len(history) > AI_MAX_HISTORY:
            del history[:-AI_MAX_HISTORY]

        messages = [{"role": "system", "content": AI_SYSTEM_PROMPT}] + history

        response = requests.post(
            "https://openrouter.ai/api/v1/chat/completions",
            json={"model": AI_MODEL, "messages": messages},
            headers={
                "Authorization": f"Bearer {OPENROUTER_KEY}",
                "Content-Type": "application/json"
            },
            timeout=30
        )
        response.raise_for_status()
        answer = response.json()["choices"][0]["message"]["content"]
        history.append({"role": "assistant", "content": answer})
        return answer
    except requests.exceptions.RequestException as e:
        log.warning(f"خطای شبکه در ارتباط با AI برای کاربر {user_id}: {e}")
        return "❌ خطا در ارتباط با هوش مصنوعی. لطفاً کمی بعد دوباره امتحان کن یا با پشتیبانی تماس بگیر."
    except (KeyError, IndexError) as e:
        log.error(f"پاسخ غیرمنتظره از AI: {e}")
        return "❌ خطا در پردازش پاسخ. لطفاً با ادمین تماس بگیرید."

