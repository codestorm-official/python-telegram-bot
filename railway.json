def get_stars_count(message):
    if not message or not message.text:
        bot.reply_to(message, "❌ لغو شد.")
        return
    
    user_id = str(message.from_user.id)
    text = message.text.strip()
    
    if not text.isdigit():
        bot.reply_to(message, f"❌ عدد بین {STARS_MIN} تا {STARS_MAX}:")
        bot.register_next_step_handler(message, get_stars_count)
        return
    
    count = int(text)
    if count < STARS_MIN or count > STARS_MAX:
        bot.reply_to(message, f"❌ بین {STARS_MIN} تا {STARS_MAX}:")
        bot.register_next_step_handler(message, get_stars_count)
        return
    
    price = count * STARS_PRICE
    data = load_data()
    if user_id not in data["pending"]:
        data["pending"][user_id] = {}
    data["pending"][user_id]["stars_count"] = count
    data["pending"][user_id]["stars_price"] = price
    save_data(data)
    
    bot.reply_to(message, "📌 استارز برای چه کسی؟", reply_markup=stars_type_keyboard())

@bot.callback_query_handler(func=lambda call: call.data in ["stars_self", "stars_other"])
def handle_stars_type(call):
    user_id = str(call.from_user.id)
    data = load_data()
    
    if user_id not in data["pending"] or "stars_count" not in data["pending"][user_id]:
        bot.answer_callback_query(call.id, "❌ اول تعداد رو وارد کن!")
        return
    
    count = data["pending"][user_id]["stars_count"]
    price = data["pending"][user_id]["stars_price"]
    
    if call.data == "stars_self":
        target = call.from_user.username or str(user_id)
        product_name = f"⭐ استارز {count} عددی برای @{target}"
        set_pending(user_id, {
            "type": "stars",
            "product": product_name,
            "amount": price,
            "count": count,
            "target": "self",
            "date": datetime.now().strftime("%Y-%m-%d %H:%M")
        })
        bot.edit_message_text(
            f"""
🛒 سفارش شما:
📦 {product_name}
💰 قیمت: {price:,} تومان
👤 برای: خودتان

{get_payment_info(price)}

📤 بعد از واریز، عکس رسید رو بفرست.
""",
            call.message.chat.id,
            call.message.message_id,
            reply_markup=cancel_payment_keyboard(),
            parse_mode="HTML"
        )
        bot.answer_callback_query(call.id, "✅ سفارش ثبت شد!")
    else:
        bot.edit_message_text("✏️ آیدی تلگرام شخص مورد نظر رو بنویس:", call.message.chat.id, call.message.message_id)
        bot.register_next_step_handler(call.message, get_stars_other, count, price)
        bot.answer_callback_query(call.id, "📝")

def get_stars_other(message, count, price):
    if not message or not message.text:
        bot.reply_to(message, "❌ لغو شد.")
        return
    
    user_id = str(message.from_user.id)
    username = message.text.strip().lstrip("@")
    
    if not username or len(username) < 3:
        bot.reply_to(message, "❌ آیدی معتبر نیست:")
        bot.register_next_step_handler(message, get_stars_other, count, price)
        return
    
    product_name = f"⭐ استارز {count} عددی برای @{username}"
    set_pending(user_id, {
        "type": "stars",
        "product": product_name,
        "amount": price,
        "count": count,
        "target": username,
        "date": datetime.now().strftime("%Y-%m-%d %H:%M")
    })
    
    bot.send_message(
        message.chat.id,
        f"""
🛒 سفارش شما:
📦 {product_name}
💰 قیمت: {price:,} تومان
👤 برای: @{username}

{get_payment_info(price)}

📤 بعد از واریز، عکس رسید رو بفرست.
""",
        reply_markup=cancel_payment_keyboard(),
        parse_mode="HTML"
    )

