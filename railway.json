def get_vpn_volume(message, plan_type):
    if not message or not message.text:
        bot.reply_to(message, "❌ لغو شد.")
        return
    
    user_id = str(message.from_user.id)
    text = message.text.strip()
    
    if not text.isdigit():
        bot.reply_to(message, f"❌ عدد بین {VPN_MIN_GB} تا {VPN_MAX_GB}:")
        bot.register_next_step_handler(message, get_vpn_volume, plan_type)
        return
    
    gb = int(text)
    if gb < VPN_MIN_GB or gb > VPN_MAX_GB:
        bot.reply_to(message, f"❌ بین {VPN_MIN_GB} تا {VPN_MAX_GB}:")
        bot.register_next_step_handler(message, get_vpn_volume, plan_type)
        return
    
    prices = {"vip": VPN_PRICE_VIP, "cip": VPN_PRICE_CIP, "custom": VPN_PRICE_CUSTOM}
    labels = {"vip": "💎 VIP", "cip": "🔷 CIP", "custom": "📦 حجمی دلخواه"}
    
    price = gb * prices[plan_type]
    product_name = f"{labels[plan_type]} {gb} گیگ"
    
    set_pending(user_id, {
        "type": "vpn",
        "product": product_name,
        "amount": price,
        "gb": gb,
        "plan": plan_type,
        "date": datetime.now().strftime("%Y-%m-%d %H:%M"),
        "expiry": get_expiry_date(30)
    })
    
    bot.send_message(
        message.chat.id,
        f"""
🛒 سفارش شما:
📦 {product_name}
💰 قیمت: {price:,} تومان
⏳ مدت: ۳۰ روز

{get_payment_info(price)}

📤 بعد از واریز، عکس رسید رو بفرست.
""",
        reply_markup=cancel_payment_keyboard(),
        parse_mode="HTML"
    )

