@bot.callback_query_handler(func=lambda call: call.data.startswith("confirm_"))
def confirm_order(call):
    user_id = call.data.replace("confirm_", "")
    pending = get_pending(user_id)
    if not pending:
        bot.answer_callback_query(call.id, "❌ سفارشی نیست!")
        return

    product_name = pending["product"]

    if pending.get("type") == "stars":
        bot.answer_callback_query(call.id, "✅")
        add_purchase(user_id, product_name)
        record_order(user_id, pending)
        remove_pending(user_id)
        try:
            bot.send_message(int(user_id), f"✅ خرید تایید شد!\n📦 {product_name}")
        except telebot.apihelper.ApiTelegramException:
            log.warning(f"نتونستم به کاربر {user_id} پیام بدم (احتمالاً ربات رو بلاک کرده).")
        try:
            bot.edit_message_caption(f"✅ استارز ارسال شد!\n👤 {user_id}", call.message.chat.id, call.message.message_id)
        except telebot.apihelper.ApiTelegramException as e:
            log.warning(f"edit_message_caption failed: {e}")
        return

    bot.answer_callback_query(call.id, "📤")
    try:
        bot.edit_message_caption(f"📝 سرور رو ارسال کن:\n👤 {user_id}\n📦 {product_name}", call.message.chat.id, call.message.message_id)
    except telebot.apihelper.ApiTelegramException as e:
        log.warning(f"edit_message_caption failed: {e}")
    msg = bot.send_message(call.message.chat.id, "📤 لطفاً سرور رو ارسال کن (متن یا عکس):")
    bot.register_next_step_handler(msg, send_server_to_user, user_id)


def send_server_to_user(message, user_id):
    pending = get_pending(user_id)
    if not pending:
        bot.reply_to(message, "❌ سفارشی نیست!")
        return

    product_name = pending["product"]
    gb = pending.get("gb", 15)
    order_date = pending.get("date", datetime.now().strftime("%Y-%m-%d %H:%M"))
    expiry_date = pending.get("expiry", get_expiry_date(30))

    if message.content_type not in ("photo", "text"):
        bot.reply_to(message, "❌ فقط متن یا عکس مجازه! دوباره ارسال کن.")
        msg = bot.send_message(message.chat.id, "📤 لطفاً سرور رو ارسال کن (متن یا عکس):")
        bot.register_next_step_handler(msg, send_server_to_user, user_id)
        return

    try:
        if message.content_type == "photo":
            file_id = message.photo[-1].file_id
            file_info = bot.get_file(file_id)
            downloaded_file = bot.download_file(file_info.file_path)
            filename = f"server_{user_id}_{int(time.time())}.jpg"
            with open(filename, "wb") as f:
                f.write(downloaded_file)
            caption_text = message.caption or ""
            with open(filename, "rb") as f:
                bot.send_photo(int(user_id), f, caption=f"""
✅ خرید شما تایید شد!
📦 {product_name}
🗜 حجم: {gb} گیگابایت
📅 تاریخ خرید: {order_date}
⏳ تاریخ انقضا: {expiry_date}
🌐 اطلاعات سرور:
{caption_text}
""")
            os.remove(filename)
        else:
            server_text = message.text.strip()
            if not server_text:
                bot.reply_to(message, "❌ خالی بود، دوباره بفرست:")
                bot.register_next_step_handler(message, send_server_to_user, user_id)
                return
            bot.send_message(int(user_id), f"""
✅ خرید شما تایید شد!
📦 {product_name}
🗜 حجم: {gb} گیگابایت
📅 تاریخ خرید: {order_date}
⏳ تاریخ انقضا: {expiry_date}
🌐 اطلاعات سرور:
{server_text}
""")

        add_purchase(user_id, product_name, f"{product_name} - {order_date}")
        record_order(user_id, pending)
        remove_pending(user_id)
        bot.reply_to(message, "✅ سرور ارسال شد!")
    except telebot.apihelper.ApiTelegramException as e:
        log.error(f"خطای تلگرام هنگام ارسال سرور به کاربر: {e}")
        bot.reply_to(message, "❌ نتونستم به کاربر پیام بدم (احتمالاً ربات رو بلاک کرده). سفارش هنوز فعاله.")
    except OSError as e:
        log.error(f"خطای فایل هنگام ارسال سرور: {e}")
        bot.reply_to(message, "❌ خطا در پردازش فایل. دوباره امتحان کن.")

@bot.callback_query_handler(func=lambda call: call.data.startswith("reject_"))
def reject_order(call):
