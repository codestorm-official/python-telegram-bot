def show_pending_orders(message):
    data = load_data()
    pending = data.get("pending", {})
    if not pending:
        bot.reply_to(message, "📋 هیچ سفارشی در انتظار نیست.")
        return
    text = "📋 سفارشات در انتظار:\n\n"
    for uid, order in pending.items():
        text += f"🆔 {uid}\n📦 {order.get('product', 'نامشخص')}\n💰 {order.get('amount', 0):,} تومان\n\n"
    bot.reply_to(message, text)

def show_users_list(message):
    data = load_data()
    users = data.get("users", {})
    banned = data.get("banned", [])
    text = f"👥 لیست کاربران:\n\n📊 کل: {len(users)}\n🚫 بن‌شده: {len(banned)}\n✅ فعال: {len(users) - len(banned)}\n\n"
    for i, uid in enumerate(list(users.keys())[:20], 1):
        status = "🚫" if uid in banned else "✅"
        uname = users[uid].get("username")
        text += f"{i}. {status} {uid}" + (f" (@{uname})" if uname else "") + "\n"
    if len(users) > 20:
        text += f"\n... و {len(users) - 20} کاربر دیگر"
    bot.reply_to(message, text)

def show_stats(message):
    data = load_data()
    users = data.get("users", {})
    orders = data.get("orders", [])
    pending = data.get("pending", {})
    total_sales = sum(o.get("amount", 0) for o in orders)
    bot.reply_to(message, f"""
📊 آمار فروش:
👥 کل کاربران: {len(users)}
📦 کل سفارشات: {len(orders)}
💰 کل فروش: {total_sales:,} تومان
⏳ سفارشات در انتظار: {len(pending)}
📅 {datetime.now().strftime("%Y-%m-%d %H:%M")}
""")

def broadcast_message(message):
    if str(message.from_user.id) != str(ADMIN_ID):
        return
    msg = message.text.strip()
    if not msg:
        bot.reply_to(message, "❌ پیام خالی.")
        return
    data = load_data()
    count = 0
    for user_id in data["users"].keys():
        if user_id in data.get("banned", []):
            continue
        try:
            bot.send_message(int(user_id), f"📨 پیام از ادمین:\n\n{msg}")
            count += 1
        except:
            pass
    bot.reply_to(message, f"✅ به {count} کاربر ارسال شد.")

