def get_custom_vpn_volume(message):
    if not message or not message.text:
        bot.reply_to(message, "❌ لغو شد.")
        return

    user_id = str(message.from_user.id)
    text = message.text.strip()

    if not text.isdigit():
        msg = bot.reply_to(message, f"❌ فقط عدد بفرست، بین {VPN_MIN_GB} تا {VPN_MAX_GB}:")
        bot.register_next_step_handler(msg, get_custom_vpn_volume)
        return

    gb = int(text)
    if gb < VPN_MIN_GB or gb > VPN_MAX_GB:
        msg = bot.reply_to(message, f"❌ بین {VPN_MIN_GB} تا {VPN_MAX_GB}:")
        bot.register_next_step_handler(msg, get_custom_vpn_volume)
        return

    price = gb * VPN_PRICE_CUSTOM
    product_name = f"{VPN_PLAN_LABELS['custom']} {gb} گیگ"

    set_pending(user_id, {
        "type": "vpn",
        "product": product_name,
        "amount": price,
        "gb": gb,
        "plan": "custom",
        "date": datetime.now().strftime("%Y-%m-%d %H:%M"),
        "expiry": get_expiry_date(30)
    })

    bot.send_message(
        message.chat.id,
        f"""
🛒 سفارش شما:
📦 {product_name}
💰 قیمت: {price:,} تومان
⏳ مدت: ۳۰ روز

{get_payment_info(price)}

📤 بعد از واریز، عکس رسید رو بفرست.
""",
        reply_markup=cancel_payment_keyboard(),
        parse_mode="HTML"
    )

