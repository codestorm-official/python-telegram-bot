def load_data():
    if os.path.exists(DATA_FILE):
        with open(DATA_FILE, 'r', encoding='utf-8') as f:
            data = json.load(f)
            for uid in data.get("users", {}):
                data["users"][uid].setdefault("purchases", [])
                data["users"][uid].setdefault("servers", [])
                data["users"][uid].setdefault("balance", 0)
                data["users"][uid].setdefault("register_date", datetime.now().strftime("%Y-%m-%d %H:%M"))
                data["users"][uid].setdefault("is_banned", False)
            return data
    return {"users": {}, "pending": {}, "banned": [], "orders": []}

def save_data(data):
    with open(DATA_FILE, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

def init_user(user_id, username=None):
    data = load_data()
    user_id = str(user_id)
    if user_id not in data["users"]:
        data["users"][user_id] = {
            "username": username,
            "purchases": [],
            "servers": [],
            "balance": 0,
            "register_date": datetime.now().strftime("%Y-%m-%d %H:%M"),
            "is_banned": False
        }
        save_data(data)
    return data["users"][user_id]

def get_pending(user_id):
    data = load_data()
    return data["pending"].get(str(user_id))

def set_pending(user_id, order):
    data = load_data()
    data["pending"][str(user_id)] = order
    save_data(data)

def remove_pending(user_id):
    data = load_data()
    if str(user_id) in data["pending"]:
        del data["pending"][str(user_id)]
        save_data(data)

def add_purchase(user_id, product_name, server_info=None):
    data = load_data()
    user_id = str(user_id)
    if user_id not in data["users"]:
        init_user(user_id)
    data["users"][user_id]["purchases"].append({
        "product": product_name,
        "date": datetime.now().strftime("%Y-%m-%d %H:%M"),
        "server": server_info
    })
    if server_info:
        data["users"][user_id]["servers"].append(server_info)
    save_data(data)

def get_banned():
    data = load_data()
    return data.get("banned", [])

def ban_user(user_id):
    data = load_data()
    user_id = str(user_id)
    if user_id not in data["banned"]:
        data["banned"].append(user_id)
        save_data(data)

def unban_user(user_id):
    data = load_data()
    user_id = str(user_id)
    if user_id in data["banned"]:
        data["banned"].remove(user_id)
        save_data(data)

def get_expiry_date(days=30):
    return (datetime.now() + timedelta(days=days)).strftime("%Y-%m-%d %H:%M")

