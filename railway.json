def get_stars_count(message):
    if not message or not message.text:
        bot.reply_to(message, "❌ لغو شد.")
        return

    user_id = str(message.from_user.id)
    text = message.text.strip()

    if not text.isdigit():
        msg = bot.reply_to(message, f"❌ عدد بین {STARS_MIN} تا {STARS_MAX}:")
        bot.register_next_step_handler(msg, get_stars_count)
        return

    count = int(text)
    if count < STARS_MIN or count > STARS_MAX:
        msg = bot.reply_to(message, f"❌ بین {STARS_MIN} تا {STARS_MAX}:")
        bot.register_next_step_handler(msg, get_stars_count)
        return

    price = count * STARS_PRICE
    update_pending_field(user_id, "stars_count", count)
    update_pending_field(user_id, "stars_price", price)

    bot.reply_to(message, "📌 استارز برای چه کسی؟", reply_markup=stars_type_keyboard())

@bot.callback_query_handler(func=lambda call: call.data in ["stars_self", "stars_other"])
def handle_stars_type(call):
    user_id = str(call.from_user.id)
    pending = get_pending(user_id)

    if not pending or "stars_count" not in pending:
        bot.answer_callback_query(call.id, "❌ اول تعداد رو وارد کن!")
        return

    count = pending["stars_count"]
    price = pending["stars_price"]

    if call.data == "stars_self":
        bot.answer_callback_query(call.id, "✅ سفارش ثبت شد!")
        target = call.from_user.username or str(user_id)
        product_name = f"⭐ استارز {count} عددی برای @{target}"
        set_pending(user_id, {
            "type": "stars", "product": product_name, "amount": price,
            "count": count, "target": "self",
            "date": datetime.now().strftime("%Y-%m-%d %H:%M")
        })
        safe_edit(
            call.message.chat.id, call.message.message_id,
            f"""
🛒 سفارش شما:
📦 {product_name}
💰 قیمت: {price:,} تومان
👤 برای: خودتان

{get_payment_info(price)}

📤 بعد از واریز، عکس رسید رو بفرست.
""",
            reply_markup=cancel_payment_keyboard()
        )
    else:
        bot.answer_callback_query(call.id, "📝")
        safe_edit(call.message.chat.id, call.message.message_id, "✏️ آیدی تلگرام شخص مورد نظر رو بنویس:")
        bot.register_next_step_handler(call.message, get_stars_other, count, price)

def get_stars_other(message, count, price):
    if not message or not message.text:
        bot.reply_to(message, "❌ لغو شد.")
        return

    user_id = str(message.from_user.id)
    username = message.text.strip().lstrip("@")

    if not username or len(username) < 3:
        msg = bot.reply_to(message, "❌ آیدی معتبر نیست:")
        bot.register_next_step_handler(msg, get_stars_other, count, price)
        return

    product_name = f"⭐ استارز {count} عددی برای @{username}"
    set_pending(user_id, {
        "type": "stars", "product": product_name, "amount": price,
        "count": count, "target": username,
        "date": datetime.now().strftime("%Y-%m-%d %H:%M")
    })

    bot.send_message(
        message.chat.id,
        f"""
🛒 سفارش شما:
📦 {product_name}
💰 قیمت: {price:,} تومان
👤 برای: @{username}

{get_payment_info(price)}

📤 بعد از واریز، عکس رسید رو بفرست.
""",
        reply_markup=cancel_payment_keyboard(), parse_mode="HTML"
    )

